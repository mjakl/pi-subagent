{
  "name": "@mjakl/pi-subagent",
  "version": "3.0.1",
  "description": "Subagent extension for Pi coding agent. Delegate prompts to specialized agents with optional named sessions.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "agents.ts",
    "contract.ts",
    "output.ts",
    "runner.ts",
    "runner-cli.js",
    "runner-events.js",
    "session-lock.ts",
    "session-paths.ts",
    "render.ts",
    "types.ts",
    "agents/*.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "subagent",
    "delegation",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjakl/pi-subagent.git"
  },
  "bugs": {
    "url": "https://github.com/mjakl/pi-subagent/issues"
  },
  "homepage": "https://github.com/mjakl/pi-subagent#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.80.5",
    "@earendil-works/pi-ai": "^0.80.5",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.80.5",
    "@types/node": "^25.2.3",
    "jiti": "^2.7.0",
    "typebox": "^1.3.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.80.5",
    "@earendil-works/pi-ai": ">=0.80.5",
    "@earendil-works/pi-coding-agent": ">=0.80.5",
    "@earendil-works/pi-tui": ">=0.80.5",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
